# Database Configuration
DATABASE_URL=sqlite:///instance/stress.db

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Socket.IO Configuration
SOCKETIO_CORS_ALLOWED_ORIGINS=*

# Question Configuration
MIN_QUESTIONS=3
MAX_QUESTIONS=6
MAX_DOMAIN_QUESTIONS=2

# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development

# Acadza API Configuration
ACADZA_AUTH=Bearer your_acadza_token_here
ACADZA_COURSE=JEE
ACADZA_API_KEY=postmanrulz
ACADZA_VERIFY=true

# Latency Optimization Flags (Optional)
ASYNC_STATE_UPDATES=true
LLM_CACHE_ENABLED=true
LLM_CACHE_SIZE=500
